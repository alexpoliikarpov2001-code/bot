# ─────────────────────────────────────────────────────────────
# Скопируй этот файл как .env и заполни значения
# ─────────────────────────────────────────────────────────────

# Токен бота
#   https://discord.com/developers/applications → New Application → Bot →
#   Reset Token → скопировать сюда
#   В разделе "Privileged Gateway Intents" включи: SERVER MEMBERS INTENT
DISCORD_TOKEN=

# ID твоего Discord-сервера
#   Discord → Settings → Advanced → Developer Mode (включить)
#   Правый клик по серверу → Copy Server ID
GUILD_ID=

# ─────────────────────────────────────────────────────────────
# DayZ сервера (для статуса)
# ─────────────────────────────────────────────────────────────

# host:port для опроса (game port серверов DayZ)
# Если не задано — берётся фолбэк из bot.js (текущие реальные адреса серверов FURY).
CHERNO_HOST=194.93.2.168
CHERNO_PORT=2312
CHERNO_DISPLAY=194.93.2.168:2312

LIVONIA_HOST=194.93.2.168
LIVONIA_PORT=2302
LIVONIA_DISPLAY=194.93.2.168:2302

NAMALSK_HOST=194.93.2.168
NAMALSK_PORT=2322
NAMALSK_DISPLAY=194.93.2.168:2322

# ─────────────────────────────────────────────────────────────
# Магазин (сделка дня в канале store)
# ─────────────────────────────────────────────────────────────
SITE_URL=https://furydayz.ru
SITE_DAILY_DEAL_API=https://furydayz.ru/api/daily-deal
