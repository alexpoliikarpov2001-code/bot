# ─────────────────────────────────────────────────────────────
# Скопируй этот файл как .env и заполни значения
# ─────────────────────────────────────────────────────────────

# Токен бота
#   https://discord.com/developers/applications → New Application → Bot →
#   Reset Token → скопировать сюда
#   В разделе "Privileged Gateway Intents" включи: SERVER MEMBERS INTENT
DISCORD_TOKEN=

# ID твоего Discord-сервера
#   Discord → Settings → Advanced → Developer Mode (включить)
#   Правый клик по серверу → Copy Server ID
GUILD_ID=

# ─────────────────────────────────────────────────────────────
# DayZ сервера (для статуса)
# ─────────────────────────────────────────────────────────────

# host:port для опроса — обычно это game port (2302/2402/2502)
# gamedig сам разберётся с steam query портом
CHERNO_HOST=play.fury.ru
CHERNO_PORT=2302
CHERNO_DISPLAY=play.fury.ru:2302

LIVONIA_HOST=play.fury.ru
LIVONIA_PORT=2402
LIVONIA_DISPLAY=play.fury.ru:2402

NAMALSK_HOST=play.fury.ru
NAMALSK_PORT=2502
NAMALSK_DISPLAY=play.fury.ru:2502
